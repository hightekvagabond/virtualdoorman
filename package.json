{
  "name": "virtualdoorman",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "android": "yarn workspace @virtualdoorman/app android",
    "start": "yarn workspace @virtualdoorman/app start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "yarn workspaces foreach --all --topological --exclude virtualdoorman --verbose run typecheck",
    "test": "yarn workspaces foreach --all --topological --exclude virtualdoorman --verbose run test"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.87.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "2.8.8",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0",
    "yarn": ">=4.0.0"
  }
}
